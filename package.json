{
  "name": "falling-blocks",
  "productName": "Falling Blocks",
  "version": "1.3.1",
  "description": "A self-playing desktop falling-block companion with local AI training.",
  "author": "Falling Blocks",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/ui-test.cjs",
    "test:soak": "node tools/soak.cjs",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  },
  "build": {
    "npmRebuild": false,
    "appId": "local.falling-blocks.companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Falling Blocks-${version}-portable.exe"
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
